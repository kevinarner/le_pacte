# Configuration du banc QA LOCAL. Aucune valeur de production ne doit
# figurer ici : le garde-fou (qa/lib/garde_fou.sh) refuse de démarrer si
# une adresse ou une clé ressemble à celles de la production.

# Dossier de travail hors du dépôt (données Postgres, sockets, journaux).
QA_DATA_DIR=/tmp/swend-qa

# Ports locaux (127.0.0.1 uniquement).
QA_PG_PORT=55450
QA_PGRST_PORT=3150
QA_API_PORT=8850
QA_APP_PORT=8851

# Bases locales : e2e (app réelle) et métier (tests SQL).
QA_DB=swend_qa
QA_DB_METIER=swend_qa_metier

# Secret de signature des jetons de la pile locale. Propre au banc QA,
# sans rapport avec la production.
QA_JWT_SECRET=qa-local-uniquement-jamais-en-production-0123456789

# Mot de passe commun des comptes de test (base locale uniquement).
QA_MOT_DE_PASSE=motdepasse-qa

# Optionnels (détectés automatiquement sinon) :
# PG_BIN=/usr/lib/postgresql/16/bin
# QA_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
